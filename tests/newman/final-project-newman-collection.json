              "            return;",
              "        }",
              "        retries++;",
              "        if (retries < maxRetries) {",
              "            setTimeout(poll, interval);",
              "            return;",
              "        }",
              "        var last = res ? res.code : (err ? err.message : 'no response');",
              "        pm.test('Status code is 404', function () { pm.expect(code).to.eql(expected, 'Timed out waiting for 404 after ' + (maxRetries * interval / 1000) + 's. Last status: ' + last); });",
              "    });",
              "}",
              "setTimeout(poll, interval);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}