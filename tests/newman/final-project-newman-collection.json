    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('e2e_suffix')) {",
          "    pm.variables.set('e2e_suffix', Date.now().toString());",
          "}",
          "var suffix = pm.variables.get('e2e_suffix');",
          "pm.collectionVariables.set('e2e_suffix', suffix);",
          "pm.collectionVariables.set('user1_username', 'seller_' + suffix);",
          "pm.collectionVariables.set('user1_email', 'seller_' + suffix + '@example.com');",
          "pm.collectionVariables.set('user1_phone', '+79' + suffix.slice(-8));",
          "pm.collectionVariables.set('user2_username', 'buyer_' + suffix);",
          "pm.collectionVariables.set('user2_email', 'buyer_' + suffix + '@example.com');",
          "pm.collectionVariables.set('user2_phone', '+78' + suffix.slice(-8));"
        ]
      }
    }
  ],
