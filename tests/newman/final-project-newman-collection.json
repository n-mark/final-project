    {
      "name": "05 - Auth: Confirm User 1 via inbox_mock",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/notification/inbox_mock/{{user1_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var expected = 200;",
              "var interval = Number(pm.collectionVariables.get('poll_interval_ms')) || 2000;",
              "var timeout = Number(pm.collectionVariables.get('poll_timeout_ms')) || 20000;",
              "var maxRetries = Math.max(1, Math.ceil(timeout / interval));",
              "var retries = 0;",
              "function poll() {",
              "    pm.sendRequest(pm.request.url.toString(), function (err, res) {",
              "        var code = res ? res.code : null;",
              "        if (!err && code === expected) {",
              "            var notifications = res.json();",
              "            if (notifications && Array.isArray(notifications) && notifications.length > 0) {",
              "                var msg = notifications[0].message || notifications[0].text || '';",
              "                var tokenMatch = msg.match(/token=([a-f0-9]+)/);",
              "                if (tokenMatch) {",
              "                    pm.test('Status code is 200', function () { pm.expect(code).to.eql(expected); });",
              "                    pm.test('Has notifications', function () { pm.expect(notifications).to.be.an('array').that.is.not.empty; });",
              "                    pm.test('Token found in notification', function () { pm.expect(tokenMatch).to.not.be.null; });",
              "                    pm.collectionVariables.set('confirm_token_1', tokenMatch[1]);",
              "                    return;",
              "                }",
              "            }",
              "        }",
              "        retries++;",
              "        if (retries < maxRetries) {",
              "            setTimeout(poll, interval);",
              "            return;",
              "        }",
              "        var last = res ? res.code : (err ? err.message : 'no response');",
              "        pm.test('Status code is 200', function () { pm.expect(code).to.eql(expected, 'Timed out waiting for notification after ' + (maxRetries * interval / 1000) + 's. Last status: ' + last); });",
              "    });",
              "}",
              "setTimeout(poll, interval);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
