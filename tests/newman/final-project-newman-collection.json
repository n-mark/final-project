    {
      "name": "28a - Search: Get Advert By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/search/{{advert_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var expected = 200;",
              "var interval = Number(pm.collectionVariables.get('poll_interval_ms')) || 2000;",
              "var timeout = Number(pm.collectionVariables.get('poll_timeout_ms')) || 20000;",
              "var maxRetries = Math.max(1, Math.ceil(timeout / interval));",
              "var retries = 0;",
              "var advertId = pm.collectionVariables.get('advert_id');",
              "function poll() {",
              "    pm.sendRequest(pm.request.url.toString(), function (err, res) {",
              "        var code = res ? res.code : null;",
              "        if (!err && code === expected) {",
              "            pm.test('Status code is 200', function () { pm.expect(code).to.eql(expected); });",
              "            var json = res.json();",
              "            pm.test('Advert id matches', function () { pm.expect(json.id).to.eql(advertId); });",
              "            pm.test('Advert title includes jacket', function () { pm.expect(json.title).to.include('E2E Test Jacket'); });",
              "            return;",
              "        }",
              "        retries++;",
              "        if (retries < maxRetries) {",
              "            setTimeout(poll, interval);",
              "            return;",
              "        }",
              "        var last = res ? res.code : (err ? err.message : 'no response');",
              "        pm.test('Status code is 200', function () { pm.expect(code).to.eql(expected, 'Timed out waiting for 200 after ' + (maxRetries * interval / 1000) + 's. Last status: ' + last); });",
              "    });",
              "}",
              "setTimeout(poll, interval);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
